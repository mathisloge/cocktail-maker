{
    "name": "cocktail-maker (Clang / libc++)",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Slint builds its Rust core from source as part of the CMake configure.
    "features": {
        "ghcr.io/devcontainers/features/rust:1": {
            "profile": "minimal"
        }
    },

    // LeakSanitizer ptraces its own process and ASan wants an unrestricted mmap
    // layout; the developer preset turns both on. Also what lldb needs to attach.
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--device=/dev/bus/usb",
        "--privileged"
    ],

    // GetGitRevisionDescription shells out to git against the workspace, and the
    // safe.directory entry also has to land before pre-commit touches .git/hooks.
    // dialout group membership lets vscode open the Pods' /dev/ttyACM* devices
    // (root:dialout, 0660) without running the Station as root.
    "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pre-commit install && sudo usermod -aG dialout vscode",

    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "Slint.slint"
            ],
            "settings": {
                "cmake.useCMakePresets": "always",
                "cmake.configureOnOpen": false
            }
        }
    },

    "remoteUser": "vscode",

    // Pod discovery reads udev_device_get_is_initialized() to decide whether a tty is
    // safe to open yet (see serial.cpp). That flag comes from the udev database, which
    // lives under /run/udev and is populated by the host's systemd-udevd
    "mounts": [
        "source=/run/udev,target=/run/udev,type=bind,readonly"
    ],

    "containerEnv": {
        "CPM_SOURCE_CACHE": "/home/vscode/.cache/CPM"
    }
}
