import { VerticalBox, ScrollView, HorizontalBox, Slider } from "std-widgets.slint";
import { Palette } from "./theme/colors.slint";
import { Layout } from "./theme/layout.slint";
import { Typography } from "./theme/typography.slint";
import { Button } from "./components/button.slint";
import { LogEntry } from "./types/log.slint";
import { Page } from "./types/navigation.slint";
import { Pod, Dispenser } from "./types/pod.slint";
import { RecipeView, Command, CommandStatus } from "./types/recipe.slint";
import { DispenserCalibrationContext } from "./globals/dispenser-calibration-context.slint";
import { GlassContext } from "./globals/glass-context.slint";
import { ProcessContext } from "./globals/process-context.slint";
import { StationStateContext } from "./globals/station-state-context.slint";
import { AdminArea } from "./pages/admin/admin-area.slint";
import { BootScreen } from "./pages/boot-screen.slint";
import { MixErrorPage } from "./pages/mix-error-page.slint";
import { MixGlassSelectionPage } from "./pages/mix-glass-selection-page.slint";
import { MixProgressPage } from "./pages/mix-progress-page.slint";
import { MixSuccessPage } from "./pages/mix-success-page.slint";
import { RecipeDetailPage } from "./pages/recipe-detail-page.slint";
import { RecipeListPage } from "./pages/recipe-list-page.slint";
import { FillWarningPopup } from "./popups/fill-warning-popup.slint";
import { ManualCommandPopup } from "./popups/manual-command-popup.slint";
import { OperatorPinPopup } from "./popups/operator-pin-popup.slint";

import "./theme/SpaceGrotesk.ttf";

export { StationStateContext }from "./globals/station-state-context.slint";
export { RecipeContext }from "./globals/recipe-context.slint";
export {
    DispenserCalibrationContext,
}from "./globals/dispenser-calibration-context.slint";
export {
    ProcessContext,
}from "./globals/process-context.slint";
export {
    GlassContext,
}from "./globals/glass-context.slint";



export component AppWindow inherits Window {
    default-font-family: Typography.font-family;
    preferred-width: 1280px;
    preferred-height: 720px;
    private property <bool> device_ready: StationStateContext.station-ready;
    in-out property <bool> boot-screen-confirmed: false;
    out property <Command> popup_command;
    out property <bool> manual-command-popup-open: false;
    out property <bool> fill-warning-popup-open: false;
    changed device_ready => {
        if (!device_ready) {
            boot-screen-confirmed = false;
        }
    }

    callback operation_canceled();
    callback manual-command-confirmed();

    public function open-manual-command-popup(command: Command) {
        root.popup_command = command;
        root.manual-command-popup-open = true;
        popup.show();
    }
    public function close-manual-command-popup() {
        root.manual-command-popup-open = false;
        popup.close();
    }

    public function open-fill-warning-popup() {
        root.fill-warning-popup-open = true;
        fill_warning_popup.show();
    }

    public function close-fill-warning-popup() {
        root.fill-warning-popup-open = false;
        fill_warning_popup.close();
    }

    operation_canceled => {
        StationStateContext.navigate-to(Page.cocktail-list-page);
    }

    public function open-operator-pin-popup() {
        operator_pin_popup.show();
    }

    public function close-operator-pin-popup() {
        operator_pin_popup.close();
    }

    operator_pin_popup := OperatorPinPopup {
        width: root.width;
        height: root.height;
    }

    fill_warning_popup := FillWarningPopup {
        width: root.width;
        height: root.height;
    }

    popup := ManualCommandPopup {
        width: root.width;
        height: root.height;
        command: root.popup_command;
        confirmed => {
            root.manual-command-confirmed();
        }
    }

    background: Palette.surface;
    if !device_ready || !boot-screen-confirmed: BootScreen {
        is-loading: !device_ready;
        boot-complete => {
            root.boot-screen-confirmed = true;
        }
    }
    if device_ready && boot-screen-confirmed: VerticalLayout {
        Rectangle {
            height: Layout.touch-height;
            Button {
                secondary: true;
                text: "← Zurück";
                x: 0px;
                width: 120px;
                visible: StationStateContext.active-screen != Page.cocktail-list-page && StationStateContext.active-screen != Page.finished-page;
                enabled: !DispenserCalibrationContext.is-busy();
                clicked => {
                    operation_canceled();
                }
            }

            Text {
                text: StationStateContext.station-name;
                font-size: Typography.title-size;
                font-weight: FontWeight.extra-bold;
                letter-spacing: 0.38rem;
                color: Palette.text-interactive;

                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;

                TouchArea {
                    long-press-timer := Timer {
                        interval: 4s;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.open-operator-pin-popup();
                        }
                    }

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            long-press-timer.running = true;
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            long-press-timer.running = false;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        if StationStateContext.active-screen == Page.cocktail-list-page: RecipeListPage {
            recipe-selected() => {
                StationStateContext.navigate-to(Page.cocktail-detail-page);
            }
        }

        if StationStateContext.active-screen == Page.cocktail-detail-page: RecipeDetailPage {
            process-recipe() => {
                // Don't show the glass selection if there is only one glass with one active volume. Process the recipe directly then.
                if (GlassContext.glasses.length == 1 && GlassContext.glasses[0].active-volumes-ml.length == 1) {
                    ProcessContext.glass = GlassContext.glasses[0];
                    ProcessContext.glass-volume = GlassContext.glasses[0].active-volumes-ml[0].to-float();
                    // business logic should navigate to mix-progress or any error page
                    ProcessContext.process-active-recipe();
                } else {
                    StationStateContext.navigate-to(Page.mix-glass-selection-page);
                }
            }
        }

        if StationStateContext.active-screen == Page.mix-page: MixProgressPage { }

        if StationStateContext.active-screen == Page.mix-glass-selection-page: MixGlassSelectionPage {
            glass-confirmed() => {
                // business logic should navigate to mix-progress or any error page
                ProcessContext.process-active-recipe();
            }
        }

        if StationStateContext.active-screen == Page.mix-error-page: MixErrorPage {
            cancel => {
                StationStateContext.navigate-to(Page.cocktail-list-page);
            }
        }

        if StationStateContext.active-screen == Page.mix-success-page: MixSuccessPage {
            finish => {
                StationStateContext.navigate-to(Page.cocktail-list-page);
            }
        }

        if StationStateContext.active-screen == Page.admin-area-page: admin-area := AdminArea { }
    }
}
