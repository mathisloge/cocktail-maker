import { SpinnerInterface } from "std-widget-interfaces.slint";
import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";

component Dot {
    in property <duration> delay;
    in property <length> size;

    // An `animate` binding only starts on a later change, and the dots are created after init, so the pulse
    // follows animation-tick() like the std spinners do.
    private property <float> phase: Math.mod((animation-tick() - root.delay) / Motion.spinner-cycle + 1, 1);
    private property <float> pulse: 0.5 - 0.5 * Math.cos(root.phase * 360deg);

    width: root.size;
    height: root.size;

    Rectangle {
        width: root.size * (0.8 + 0.2 * root.pulse);
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent;
        opacity: 0.25 + 0.75 * root.pulse;
    }
}

// Three amber dots that pulse one after the other.
export component LoadingSpinner {
    implement SpinnerInterface <=> self;

    in property <bool> indeterminate: true;
    in property <float> progress;
    in property <length> dot-size: Layout.spinner-dot-size;

    HorizontalLayout {
        alignment: center;
        spacing: root.dot-size;
        for index in 3: VerticalLayout {
            alignment: center;
            Dot {
                size: root.dot-size;
                delay: Motion.spinner-cycle / 3 * index;
            }
        }
    }
}
