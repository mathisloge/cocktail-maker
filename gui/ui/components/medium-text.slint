import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Typography } from "../theme/typography.slint";

export component MediumText inherits Text {
    in property <bool> primary;
    color: primary ? Palette.text-primary : Palette.text-interactive;
    letter-spacing: 1.5pt;
    font-size: Typography.body-size;
}
