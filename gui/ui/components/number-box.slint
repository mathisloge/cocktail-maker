import { SpinBox, Palette as StdPalette } from "std-widgets.slint";

// The only place that uses the std-widget, so that theming it later is a change in this file.
export component NumberBox inherits SpinBox {
    // The std style follows the system and draws light controls, which would stand out on the dark theme.
    init => {
        StdPalette.color-scheme = ColorScheme.dark;
    }
}
