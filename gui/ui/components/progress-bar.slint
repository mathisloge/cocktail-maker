import { ProgressIndicatorInterface } from "std-widget-interfaces.slint";
import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";

// An amber light sweep while indeterminate, otherwise an amber fill for the progress from 0 to 1.
export component ProgressBar {
    implement ProgressIndicatorInterface <=> self;

    in property <float> progress;
    in property <bool> indeterminate;

    private property <length> sweep-width: root.width * 0.3;

    height: Layout.progress-height;

    Rectangle {
        background: Palette.surface-elevated;
        clip: true;

        if !root.indeterminate: Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.progress));
            background: Palette.accent;
        }

        // An `animate` binding only starts on a later change, and this sweep is created after init,
        // so its position follows animation-tick().
        if root.indeterminate: Rectangle {
            x: -root.sweep-width + (parent.width + root.sweep-width) * Math.mod(animation-tick() / Motion.sweep, 1);
            width: root.sweep-width;
            background: @linear-gradient(90deg, transparent 0%, Palette.accent 50%, transparent 100%);
        }
    }
}
