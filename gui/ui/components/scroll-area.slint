import { ScrollView, Palette as StdPalette } from "std-widgets.slint";

// The only place that uses the std-widget, so that theming it later is a change in this file.
export component ScrollArea inherits ScrollView {
    // The std style follows the system and draws light controls, which would stand out on the dark theme. Every
    // wrapper sets the scheme, so the first std control on screen is already dark.
    init => {
        StdPalette.color-scheme = ColorScheme.dark;
    }
}
