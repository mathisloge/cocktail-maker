import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { CaptionText } from "./text.slint";

export component SeparatorText {
    in property <string> text;
    HorizontalLayout {
        spacing: Layout.spacing-lg;
        cross-axis-alignment: center;

        CaptionText {
            tone: TextTone.label;
            horizontal-alignment: center;
            text: root.text;
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }
    }
}
