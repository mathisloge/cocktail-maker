import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { SmallText } from "./small-text.slint";

export component SeparatorText {
    in property <string> text;
    HorizontalLayout {
        spacing: Layout.spacing-lg;
        cross-axis-alignment: center;

        SmallText {
            text: root.text;
            color: Palette.text-label;
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }
    }
}
