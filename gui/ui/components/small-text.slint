import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Typography } from "../theme/typography.slint";

export component SmallText inherits Text {
    in property <bool> highlight: false;
    color: highlight ? Palette.text-interactive : Palette.text-muted;
    font-size: Typography.caption-size;
    font-weight: FontWeight.normal;
    letter-spacing: 2pt;
    horizontal-alignment: center;
}
