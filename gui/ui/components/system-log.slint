import { LogEntry, LogLevel } from "../data.slint";
import { Palette, Layout } from "../palette.slint";
import { SmallText } from "./small-text.slint";

component LogCell inherits SmallText {
    letter-spacing: 0.5px;
    horizontal-alignment: left;
    vertical-alignment: center;
    horizontal-stretch: 0;
    overflow: elide;
}

component LogRow inherits Rectangle {
    in property <LogEntry> entry;

    private property <color> level-color: root.entry.level == LogLevel.trace ? Palette.log-trace
        : root.entry.level == LogLevel.debug ? Palette.log-debug
        : root.entry.level == LogLevel.info ? Palette.log-info
        : root.entry.level == LogLevel.warn ? Palette.log-warn
        : root.entry.level == LogLevel.err ? Palette.log-error
        : root.entry.level == LogLevel.critical ? Palette.log-critical
        : Palette.log-info;
    private property <bool> is-problem: root.entry.level == LogLevel.warn || root.entry.level == LogLevel.err || root.entry.level == LogLevel.critical;

    background: root.is-problem ? root.level-color.with-alpha(0.08) : transparent;

    Rectangle {
        x: 0;
        width: 3px;
        background: root.level-color.with-alpha(root.is-problem ? 1.0 : 0.45);
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border-subtle;
    }

    HorizontalLayout {
        padding-left: Layout.spacing-md;
        padding-right: Layout.spacing-md;
        padding-top: Layout.spacing-xs;
        padding-bottom: Layout.spacing-xs;
        spacing: Layout.spacing-md;

        LogCell {
            width: 100px;
            text: root.entry.time-stamp;
        }

        LogCell {
            width: 52px;
            text: root.entry.level == LogLevel.trace ? "TRACE"
                : root.entry.level == LogLevel.debug ? "DEBUG"
                : root.entry.level == LogLevel.info ? "INFO"
                : root.entry.level == LogLevel.warn ? "WARN"
                : root.entry.level == LogLevel.err ? "ERROR"
                : root.entry.level == LogLevel.critical ? "CRIT"
                : "INFO";
            letter-spacing: 1.5px;
            font-weight: FontWeight.bold;
            color: root.level-color;
        }

        LogCell {
            width: 120px;
            text: root.entry.component;
            color: Palette.text-label;
        }

        LogCell {
            horizontal-stretch: 1;
            text: root.entry.message;
            color: root.entry.level == LogLevel.err || root.entry.level == LogLevel.critical ? Palette.log-error : Palette.text-primary;

            Tooltip {
                Text {
                    text: root.entry.message;
                    wrap: word-wrap;
                    width: 300px;
                    font-size: Layout.font-size-sm;
                    horizontal-alignment: start;
                }
            }
        }
    }
}

export component SystemLog inherits Flickable {
    in property <[LogEntry]> log-entries: [
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.trace,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        },
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.debug,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        },
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.info,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        },
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.warn,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        },
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.err,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        },
        {
            time_stamp: "10:10:10.000",
            level: LogLevel.critical,
            component: "some-longer-component",
            message:"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
        }
    ];

    content-height: log-content.preferred-height;

    log-content := VerticalLayout {
        padding-top: Layout.spacing-sm;
        padding-bottom: Layout.spacing-sm;
        alignment: start;

        for entry in root.log-entries: LogRow {
            entry: entry;
        }
    }
}
