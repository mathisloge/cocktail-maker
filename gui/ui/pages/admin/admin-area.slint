import { TextTone, Palette } from "../../theme/colors.slint";
import { Layout } from "../../theme/layout.slint";
import { LabelText } from "../../components/text.slint";
import { DispenserCalibrationContext } from "../../globals/dispenser-calibration-context.slint";
import { StationStateContext } from "../../globals/station-state-context.slint";
import { Dispenser, Pod } from "../../types/pod.slint";
import { GlassConfigTab } from "./glass-config-tab.slint";
import { PumpPage } from "./pump-page.slint";
import { PumpsSection } from "./pumps-section.slint";
import { SystemSection } from "./system-section.slint";

enum AdminSection {
    pumps,
    glasses,
    system,
}

component SectionTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> enabled <=> touch.enabled;
    callback clicked();

    min-width: Layout.back-button-width;
    background: root.active ? Palette.accent-dim : touch.pressed ? Palette.surface-elevated : transparent;

    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-selected: root.active;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    LabelText {
        text: root.title;
        emphasized: root.active;
        horizontal-alignment: center;
        vertical-alignment: center;
        tone: root.active ? TextTone.interactive : TextTone.muted;
        // The tab itself carries the label.
        accessible-role: none;
        accessible-label: "";
    }

    Rectangle {
        y: parent.height - self.height;
        height: Layout.accent-bar;
        background: root.active ? Palette.accent : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AdminArea {
    // The page of a single pump, opened from its tile inside the Pumpen section.
    in-out property <bool> pump-open;
    property <Pod> open-pod;
    property <Dispenser> open-dispenser;
    private property <int> open-pod-index;
    private property <int> open-dispenser-index;
    private property <AdminSection> section: AdminSection.pumps;
    // The pump page follows the model, so that refills and new drinks show while it is open. It keeps the last state
    // when the rows have moved, because its Pod went away.
    private property <Pod> live-pod: StationStateContext.pods[root.open-pod-index];
    private property <bool> live: root.live-pod.id == root.open-pod.id && root.open-dispenser-index < root.live-pod.dispensers.length;

    VerticalLayout {
        Rectangle {
            background: Palette.surface-card;
            height: Layout.touch-height-sm;

            HorizontalLayout {
                padding-left: Layout.spacing-md;

                LabelText {
                    text: "WARTUNG";
                    emphasized: true;
                    tone: TextTone.label;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                for item in [
                    { section: AdminSection.pumps, title: "Pumpen" },
                    { section: AdminSection.glasses, title: "Gläser" },
                    { section: AdminSection.system, title: "System" },
                ]: SectionTab {
                    title: item.title;
                    active: root.section == item.section;
                    enabled: !DispenserCalibrationContext.is-busy();
                    clicked => {
                        root.section = item.section;
                        root.pump-open = false;
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.section == AdminSection.pumps && !root.pump-open: PumpsSection {
                width: 100%;
                height: 100%;
                open(pod-index, dispenser-index) => {
                    root.open-pod-index = pod-index;
                    root.open-dispenser-index = dispenser-index;
                    root.open-pod = StationStateContext.pods[pod-index];
                    root.open-dispenser = root.open-pod.dispensers[dispenser-index];
                    root.pump-open = true;
                }
                details => {
                    root.section = AdminSection.system;
                }
            }

            if root.section == AdminSection.pumps && root.pump-open: PumpPage {
                width: 100%;
                height: 100%;
                pod: root.live ? root.live-pod : root.open-pod;
                dispenser: root.live ? root.live-pod.dispensers[root.open-dispenser-index] : root.open-dispenser;
                back => {
                    root.pump-open = false;
                }
            }

            if root.section == AdminSection.system: SystemSection {
                width: 100%;
                height: 100%;
            }

            // The glasses stay instantiated so that switching keeps their state.
            GlassConfigTab {
                width: 100%;
                height: 100%;
                visible: root.section == AdminSection.glasses;
            }

        }
    }
}
