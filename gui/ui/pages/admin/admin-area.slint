import { TextTone, Palette } from "../../theme/colors.slint";
import { Layout } from "../../theme/layout.slint";
import { Typography } from "../../theme/typography.slint";
import { LabelText } from "../../components/text.slint";
import { StationStateContext } from "../../globals/station-state-context.slint";
import { SystemLog } from "../../widgets/system-log.slint";
import { GlassConfigTab } from "./glass-config-tab.slint";
import { PodConfigTab } from "./pod-config-tab.slint";

component AdminTab inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback clicked();

    min-height: Layout.touch-height-sm;
    horizontal-stretch: 1;
    background: root.active ? Palette.accent-dim : touch.pressed ? Palette.surface-elevated : transparent;

    LabelText {
        text: root.title;
        emphasized: root.active;
        horizontal-alignment: center;
        vertical-alignment: center;
        tone: root.active ? TextTone.interactive : TextTone.muted;
    }

    Rectangle {
        y: parent.height - self.height;
        height: Layout.accent-bar;
        background: root.active ? Palette.accent : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AdminArea {
    private property <int> current-tab: 0;

    VerticalLayout {
        Rectangle {
            background: Palette.surface-card;

            HorizontalLayout {
                for title[index] in ["POD CONFIG", "GLASS CONFIG", "SYSTEM LOGS"]: AdminTab {
                    title: title;
                    active: root.current-tab == index;
                    clicked => {
                        root.current-tab = index;
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.border;
            }
        }

        // All tabs stay instantiated so that switching keeps their state.
        Rectangle {
            vertical-stretch: 1;

            PodConfigTab {
                width: 100%;
                height: 100%;
                visible: root.current-tab == 0;
            }

            GlassConfigTab {
                width: 100%;
                height: 100%;
                visible: root.current-tab == 1;
            }

            SystemLog {
                width: 100%;
                height: 100%;
                visible: root.current-tab == 2;
                log-entries: StationStateContext.log-entries;
            }
        }
    }
}
