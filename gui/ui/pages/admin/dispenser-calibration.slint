import { TextTone, Palette } from "../../theme/colors.slint";
import { Layout } from "../../theme/layout.slint";
import { Motion } from "../../theme/motion.slint";
import { Button } from "../../components/button.slint";
import { NumberBox } from "../../components/number-box.slint";
import { PulseDot } from "../../components/pulse-dot.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { CaptionText, BodyText } from "../../components/text.slint";
import { Pod, Dispenser } from "../../types/pod.slint";
import { DispenserCalibrationContext, CalibrationStepStatus } from "../../globals/dispenser-calibration-context.slint";

component StatusDot inherits PulseDot {
    in property <CalibrationStepStatus> status;
    width: 14px;
    height: 14px;
    border-radius: self.height / 2;
    background: root.status == CalibrationStepStatus.success ? Palette.log-info :
        root.status == CalibrationStepStatus.running ? Palette.log-debug :
        root.status == CalibrationStepStatus.error ? Palette.log-error :
        Palette.border-subtle;
}

component StepCard inherits Rectangle {
    in property <string> step-number;
    in property <string> title: "Test title";
    in property <string> description: "Test description";
    in property <CalibrationStepStatus> status: CalibrationStepStatus.running;
    in property <bool> enabled: true;

    background: Palette.surface-card;
    border-width: 1px;
    border-color: Palette.border-subtle;
    opacity: root.enabled ? 1.0 : 0.45;
    animate opacity { duration: Motion.quick; }

    function status-label() -> string {
        if (root.status == CalibrationStepStatus.success) {
            return "OK";
        }
        if (root.status == CalibrationStepStatus.running) {
            return "läuft...";
        }
        if (root.status == CalibrationStepStatus.error) {
            return "Fehler";
        }
        return "ausstehend";
    }

    VerticalLayout {
        padding: Layout.spacing-md;
        spacing: Layout.spacing-md;

        HorizontalLayout {
            spacing: Layout.spacing-sm;
            alignment: start;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.height / 2;
                background: Palette.surface-elevated;

                CaptionText {
                    tone: TextTone.primary;
                    emphasized: true;
                    text: root.step-number;
                }
            }

            BodyText {
                tone: TextTone.interactive;
                text: root.title;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                padding: Layout.spacing-sm;
                spacing: Layout.spacing-xs;
                cross-axis-alignment: center;
                StatusDot {
                    status: root.status;
                }

                CaptionText {
                    tone: TextTone.interactive;
                    horizontal-alignment: center;
                    text: root.status-label();
                }
            }
        }

        CaptionText {
            tone: TextTone.interactive;
            horizontal-alignment: center;
            text: root.description;
            wrap: word-wrap;
        }

        @children
    }
}

// The calibration steps of one dispenser, shown on its pump page.
export component DispenserCalibrationPanel {
    in property <Pod> active-pod;
    in property <Dispenser> active-dispenser;
    callback done();
    private property <int> reference-weight-g: 100;
    private property <int> run-time-s: DispenserCalibrationContext.default-run-time-s;

    VerticalLayout {
        spacing: Layout.spacing-md;

        HorizontalLayout {
            spacing: Layout.spacing-sm;

            BodyText {
                tone: TextTone.interactive;
                text: root.active-dispenser.label + " kalibrieren";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // It stays disabled while something runs, as the way to stop a run is in here.
            Button {
                text: "Fertig";
                compact: true;
                secondary: true;
                enabled: !DispenserCalibrationContext.is-busy();
                clicked => {
                    root.done();
                }
            }
        }

        if DispenserCalibrationContext.state.error-message != "": CaptionText {
            tone: TextTone.log-error;
            horizontal-alignment: center;
            text: DispenserCalibrationContext.state.error-message;
            wrap: word-wrap;
        }

        ScrollArea {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Layout.spacing-md;

                StepCard {
                    step-number: "1";
                    title: "Wägezelle";
                    description: "Nur beim Einbau der Wägezelle nötig. Waage leeren und tarieren, danach das Referenzgewicht auflegen und kalibrieren.";
                    status: DispenserCalibrationContext.load-cell-card-status();

                    Button {
                        text: DispenserCalibrationContext.state.load-cell-tare-status == CalibrationStepStatus.running
                            ? "läuft..." : "Tara (leere Waage)";
                        compact: true;
                        enabled: DispenserCalibrationContext.state.load-cell-tare-status != CalibrationStepStatus.running;
                        clicked => {
                            DispenserCalibrationContext.load-cell-tare(
                                root.active-pod,
                                root.active-dispenser);
                        }
                    }

                    HorizontalLayout {
                        padding: Layout.spacing-sm;
                        cross-axis-alignment: center;
                        spacing: Layout.spacing-md;
                        CaptionText {
                            horizontal-alignment: center;
                            text: "Gewicht (g):";
                        }

                        NumberBox {
                            height: Layout.touch-height-sm;
                            minimum: 1;
                            maximum: 20000;
                            value <=> root.reference-weight-g;
                            enabled: DispenserCalibrationContext.state.load-cell-status != CalibrationStepStatus.running;
                        }
                    }

                    Button {
                        text: DispenserCalibrationContext.state.load-cell-status == CalibrationStepStatus.running
                            ? "läuft..." : "Mit Referenzgewicht kalibrieren";
                        compact: true;
                        enabled: DispenserCalibrationContext.state.load-cell-tare-status == CalibrationStepStatus.success
                            && DispenserCalibrationContext.state.load-cell-status != CalibrationStepStatus.running;
                        clicked => {
                            DispenserCalibrationContext.calibrate-load-cell-ref-weight(
                                root.active-pod,
                                root.active-dispenser,
                                root.reference-weight-g);
                        }
                    }

                    if DispenserCalibrationContext.state.reference-reading != "": CaptionText {
                        tone: TextTone.log-info;
                        horizontal-alignment: center;
                        text: "Waage zeigt: " + DispenserCalibrationContext.state.reference-reading;
                    }
                }

                StepCard {
                    step-number: "2";
                    title: "Leere Flasche";
                    description: "Leere Flasche aufsetzen und tarieren. Der Füllstand steht danach auf 0.";
                    status: DispenserCalibrationContext.state.empty-bottle-tare-status;

                    Button {
                        text: DispenserCalibrationContext.state.empty-bottle-tare-status == CalibrationStepStatus.running
                            ? "läuft..." : "Tara (leere Flasche)";
                        compact: true;
                        enabled: DispenserCalibrationContext.state.empty-bottle-tare-status != CalibrationStepStatus.running;
                        clicked => {
                            DispenserCalibrationContext.empty-bottle-tare(
                                root.active-pod,
                                root.active-dispenser);
                        }
                    }
                }

                StepCard {
                    step-number: "3";
                    title: "Dispenser";
                    // codespell:ignore-next-line
                    description: "Gefüllte Flasche auf der Waage und ein Glas unter den Auslauf stellen. Es fließt echte Flüssigkeit.";
                    status: DispenserCalibrationContext.state.dispenser-status;

                    HorizontalLayout {
                        padding: Layout.spacing-sm;
                        cross-axis-alignment: center;
                        spacing: Layout.spacing-md;
                        CaptionText {
                            horizontal-alignment: center;
                            text: "Laufzeit (s):";
                        }

                        NumberBox {
                            height: Layout.touch-height-sm;
                            minimum: DispenserCalibrationContext.min-run-time-s;
                            maximum: DispenserCalibrationContext.max-run-time-s;
                            value <=> root.run-time-s;
                            enabled: DispenserCalibrationContext.state.dispenser-status != CalibrationStepStatus.running;
                        }
                    }

                    Button {
                        text: DispenserCalibrationContext.state.dispenser-status == CalibrationStepStatus.running
                            ? "läuft..." : "Lauf starten";
                        compact: true;
                        enabled: DispenserCalibrationContext.state.dispenser-status != CalibrationStepStatus.running;
                        clicked => {
                            DispenserCalibrationContext.calibrate-dispenser(
                                root.active-pod,
                                root.active-dispenser,
                                root.run-time-s);
                        }
                    }

                    if DispenserCalibrationContext.state.dispenser-status == CalibrationStepStatus.running: Button {
                        // codespell:ignore-next-line
                        text: "Stopp";
                        compact: true;
                        clicked => {
                            DispenserCalibrationContext.stop-calibration();
                        }
                    }

                    if DispenserCalibrationContext.state.dispenser-status == CalibrationStepStatus.success: CaptionText {
                        tone: TextTone.log-info;
                        horizontal-alignment: center;
                        text: "Gemessen: " + DispenserCalibrationContext.state.measured-amount;
                    }

                    if DispenserCalibrationContext.state.dispenser-status == CalibrationStepStatus.success
                        && DispenserCalibrationContext.state.below-recommended-amount: CaptionText {
                        tone: TextTone.interactive;
                        horizontal-alignment: center;
                        text: "Für eine genauere Kalibrierung eine längere Laufzeit wählen.";
                        wrap: word-wrap;
                    }
                }

            }
        }
    }
}
