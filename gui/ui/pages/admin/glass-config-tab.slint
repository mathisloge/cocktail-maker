import { ComboBox, VerticalBox, Button, HorizontalBox } from "std-widgets.slint";
import { Palette } from "../../theme/colors.slint";
import { Layout } from "../../theme/layout.slint";
import { Chip } from "../../components/chip.slint";
import { MediumText } from "../../components/medium-text.slint";
import { PulseDot } from "../../components/pulse-dot.slint";
import { GlassDescriptor } from "../../types/glass.slint";
import { GlassContext } from "../../globals/glass-context.slint";
import { GlassCard } from "../../widgets/glass-card.slint";
import { GlassIcon } from "../../widgets/glass-icon.slint";

export component GlassConfigTab inherits Rectangle {
    private property <GlassDescriptor> selected-glass;
    VerticalBox {
        alignment: LayoutAlignment.start;
        HorizontalBox {
            vertical-stretch: 0;
            glass-chooser := ComboBox {
                width: 100px;
                height: Layout.touch-height-sm;
                model: GlassContext.available-glasses;
            }

            Button {
                text: "Add";
                clicked => {
                    GlassContext.add-glass(glass-chooser.current-value)
                }
            }
        }

        Flickable {
            height: 232px;
            glass-row := HorizontalLayout {
                spacing: Layout.spacing-md;

                for descriptor[index] in GlassContext.glasses: GlassCard {
                    descriptor: descriptor;
                    selected: selected-glass.id == descriptor.id;
                    clicked => {
                        selected-glass = descriptor;
                    }

                    Button {
                        x: parent.width - self.width - Layout.spacing-sm;
                        y: Layout.spacing-sm;
                        min-width: Layout.touch-height-sm;
                        min-height: Layout.touch-height-sm;
                        text: "x";
                        clicked => {
                            GlassContext.remove-glass(descriptor.id);
                        }
                    }
                }
            }
        }

        HorizontalBox {
            vertical-stretch: 0;
            volume-box := ComboBox {
                width: 100px;
                height: Layout.touch-height-sm;
                model: selected-glass.common-volumes-ml;
            }

            Button {
                text: "Add";
                clicked => {
                    GlassContext.add-volume-from-glass(selected-glass.id, volume-box.current-value.to-float())
                }
            }
        }

        Flickable {
            height: Layout.touch-height;

            volume-row := HorizontalLayout {
                spacing: Layout.spacing-md;

                for volume in selected-glass.active-volumes-ml: Chip {
                    width: 110px;
                    text: volume;
                    clicked => { GlassContext.remove-volume-from-glass(selected-glass.id, volume.to-float()); }
                }
            }
        }
    }
}
