import { TextTone, Palette } from "../../theme/colors.slint";
import { Layout } from "../../theme/layout.slint";
import { Motion } from "../../theme/motion.slint";
import { Button } from "../../components/button.slint";
import { PulseDot } from "../../components/pulse-dot.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { SelectBox } from "../../components/select-box.slint";
import { CaptionText, BodyText } from "../../components/text.slint";
import { Pod, Dispenser, ConnectionState, DispenserType } from "../../types/pod.slint";
import { Ingredient } from "../../types/recipe.slint";
import { DispenserCalibrationContext } from "../../globals/dispenser-calibration-context.slint";
import { RecipeContext } from "../../globals/recipe-context.slint";
import { StationStateContext } from "../../globals/station-state-context.slint";
import { SystemLog } from "../../widgets/system-log.slint";
import { DispenserCalibrationPopup } from "./dispenser-calibration.slint";

component PodListDelegate inherits Rectangle {
    in property <Pod> pod;
    in property <bool> selected;
    callback clicked();

    background: Palette.surface-card;
    border-width: 1px;
    border-color: root.selected ? Palette.border-strong : Palette.border-subtle;
    animate background, border-color { duration: Motion.quick; }

    HorizontalLayout {
        padding: Layout.spacing-sm;
        spacing: Layout.spacing-sm;
        cross-axis-alignment: center;
        PulseDot {
            pulse: pod.connection-state == ConnectionState.connecting;
            background: pod.connection-state == ConnectionState.connected ? Palette.log-info :
                pod.connection-state == ConnectionState.connecting ? Palette.log-debug :
                Palette.log-error;
        }

        VerticalLayout {
            alignment: center;
            title := CaptionText {
                horizontal-alignment: center;
                text: pod.id;
                animate color { duration: Motion.quick; }
            }

            if pod.status-text != "": CaptionText {
                tone: TextTone.log-error;
                horizontal-alignment: center;
                text: pod.status-text;
            }
        }
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    states [
        pressed when touch-area.pressed: {
            root.background: Palette.surface-elevated.brighter(1);
            root.border-color: Palette.border;
            title.tone: TextTone.primary;
        }
        hover when touch-area.has-hover: {
            root.background: Palette.surface-elevated;
        }
    ]
}

export component PodConfigTab inherits Rectangle {
    private property <Pod> active-pod;
    private property <Dispenser> active-dispenser;

    sidebar := VerticalLayout {
        x: 0;
        y: 0;
        width: 33%;

        ScrollArea {
            VerticalLayout {
                alignment: start;
                for pod in StationStateContext.pods: PodListDelegate {
                    height: Layout.list-row-height;
                    pod: pod;
                    selected: root.active-pod == pod;
                    clicked => { root.active-pod = pod; }
                }
            }
        }
    }

    split := Rectangle {
        width: 1px;
        height: 100%;
        x: sidebar.width;
        y: 0;
        background: Palette.border;
    }

    content := VerticalLayout {
        padding: Layout.spacing-sm;
        spacing: Layout.spacing-sm;
        x: split.x + split.width;
        y: 0;
        width: root.width - sidebar.width - split.width;
        alignment: stretch;

        BodyText {
            tone: TextTone.interactive;
            text: active-pod.id;
        }

        if active-pod.status-text != "": CaptionText {
            tone: TextTone.log-error;
            horizontal-alignment: center;
            text: active-pod.status-text;
        }

        ScrollArea {
            VerticalLayout {
                padding: Layout.spacing-sm;
                spacing: Layout.spacing-sm;
                for dispenser in root.active-pod.dispensers: HorizontalLayout {
                    padding: Layout.spacing-sm;
                    spacing: Layout.spacing-sm;
                    cross-axis-alignment: center;
                    CaptionText {
                        horizontal-alignment: center;
                        text: "Dispenser " + dispenser.id;
                    }

                    CaptionText {
                        tone: TextTone.interactive;
                        horizontal-alignment: center;
                        text: dispenser.fill-text;
                    }

                    SelectBox {
                        height: Layout.touch-height-sm;
                        model: RecipeContext.ingredient-ids;
                        selected(current-value) => {
                            RecipeContext.assign-ingredient-to-dispenser(active-pod, dispenser, current-value);
                        }
                    }

                    Button {
                        text: "Nachgefüllt";
                        compact: true;
                        clicked => { StationStateContext.mark-dispenser-refilled(active-pod, dispenser); }
                    }

                    Button {
                        text: "Identify";
                        compact: true;
                        clicked => { StationStateContext.highlight-dispenser(active-pod, dispenser); }
                    }

                    Button {
                        text: "Calibrate";
                        compact: true;
                        clicked => {
                            root.active-dispenser = dispenser;
                            DispenserCalibrationContext.reset-state();
                            cal.show();
                        }
                    }
                }
            }
        }
    }

    cal := DispenserCalibrationPopup {
        width: root.width;
        height: root.height;
        active-pod: root.active-pod;
        active-dispenser: root.active-dispenser;
    }
}
