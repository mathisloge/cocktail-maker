import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { CornerDeco } from "../components/corner-deco.slint";
import { LargeText } from "../components/large-text.slint";
import { LoadingSpinner } from "../components/loading-spinner.slint";
import { ProgressBar } from "../components/progress-bar.slint";
import { PulseDot } from "../components/pulse-dot.slint";
import { ScrollArea } from "../components/scroll-area.slint";
import { Separator } from "../components/separator.slint";
import { SmallText } from "../components/small-text.slint";
import { LogEntry, LogLevel } from "../types/log.slint";
import { StationStateContext } from "../globals/station-state-context.slint";
import { SystemLog } from "../widgets/system-log.slint";
import { PageBase } from "./page-base.slint";

export component BootScreen inherits PageBase {
    in property <bool> is-loading:   false;
    private property <[LogEntry]> log-entries: StationStateContext.log-entries;

    callback boot-complete();

    private property <int> entry-count: log-entries.length;

    HorizontalLayout {

        // ── LEFT: branding + spinner ─────────────────────────
        left-panel := Rectangle {
            horizontal-stretch: 42;
            background: Palette.surface;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Palette.border;
            }

            // Corner deco marks
            CornerDeco {
                width: 100%;
                height: 100%;
            }

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                padding: Layout.spacing-xl * 1.3;
                spacing: 0;

                SmallText {
                    text: "COCKTAIL MACHINE";
                    font-size: Typography.caption-size;
                    letter-spacing: 4px;
                }

                Rectangle {
                    height: Layout.spacing-md;
                }

                LargeText {
                    text: StationStateContext.station-name;
                    font-italic: true;
                }

                Rectangle {
                    height: Layout.spacing-sm;
                }

                Separator {
                    width: Layout.spacing-xl * 1.3;
                }

                Rectangle {
                    height: Layout.spacing-xl * 1.3;
                }

                if root.is-loading:  LoadingSpinner {
                    indeterminate: true;
                    width: Layout.spacing-xl * 1.3;
                    height: Layout.spacing-xl * 1.3;
                }

                if !root.is-loading:  Button {
                    height: Layout.touch-height;
                    text: "START →";
                    clicked => { root.boot-complete(); }
                }

                Rectangle {
                    height: Layout.spacing-md;
                    background: transparent;
                }

                SmallText {
                    text: root.is-loading ? "WIRD GESTARTET …" : "BEREIT";
                    color: root.is-loading ? Palette.accent : Palette.text-success;
                    animate color { duration: 400ms; }
                }
            }
        }

        // ── RIGHT: boot log ──────────────────────────────────
        Rectangle {
            horizontal-stretch: 58;
            background: Palette.surface-card;

            VerticalLayout {
                spacing: 0;

                // Toolbar
                Rectangle {
                    height: Layout.spacing-xl;
                    background: Palette.surface;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Palette.border;
                    }

                    HorizontalLayout {
                        padding-left: Layout.spacing-lg;
                        padding-right: Layout.spacing-lg;
                        spacing: Layout.spacing-sm;
                        alignment: start;
                        cross-axis-alignment: center;

                        PulseDot {
                            background: root.is-loading ? Palette.accent : Palette.text-success;
                        }

                        SmallText {
                            text: "SYSTEM LOG";
                            font-size: Typography.caption-size;
                            letter-spacing: 3.5px;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        SmallText {
                            text: root.log-entries.length + " ZEILEN";
                            font-size: Typography.caption-size;
                            letter-spacing: 2px;
                            highlight: true;
                            vertical-alignment: center;
                        }
                    }
                }

                SystemLog {
                    log-entries: root.log-entries;
                }
            }
        }
    }
}
