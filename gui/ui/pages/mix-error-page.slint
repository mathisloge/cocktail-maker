import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { CornerDeco } from "../components/corner-deco.slint";
import { SeparatorText } from "../components/separator-text.slint";
import { LabelText, DisplayText, CaptionText, BodyText } from "../components/text.slint";
import { ProcessContext } from "../globals/process-context.slint";
import { RecipeContext } from "../globals/recipe-context.slint";
import { CommandItem } from "../widgets/command-item.slint";
import { PageBase } from "./page-base.slint";

// ─────────────────────────────────────────────────────────────────────
//  Small local helper — one "what failed" detail row
//  (not exported; scoped to this file)
// ─────────────────────────────────────────────────────────────────────
component ErrorDetailRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> sub-label;

    height: 56px;
    background: Palette.surface-card;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 0px;
        spacing: Layout.spacing-md;

        Rectangle {
            width: 30px;
            horizontal-stretch: 0;
            BodyText {
                tone: TextTone.muted;
                horizontal-alignment: center;
                text: root.icon;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Layout.spacing-xs;
            LabelText {
                emphasized: true;
                text: root.label;
                font-italic: false;
            }

            CaptionText {
                horizontal-alignment: center;
                text: root.sub-label;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Rectangle {
            horizontal-stretch: 0;
            background: transparent;
            border-width: 1px;
            border-color: Palette.text-error;
            HorizontalLayout {
                padding: Layout.spacing-xs;
                CaptionText {
                    tone: TextTone.error;
                    emphasized: true;
                    horizontal-alignment: center;
                    text: "FAILED";
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component MixErrorPage inherits PageBase {
    private property <string> cocktail-name:            RecipeContext.active-recipe.name;
    private property <string> customer-title:           ProcessContext.customer-title;
    private property <string> customer-message:         ProcessContext.customer-message;
    private property <string> technical-title:          ProcessContext.technical-title;
    private property <string> technical-reason:         ProcessContext.technical-description;
    private property <string> failed-ingredient-icon:   ProcessContext.error-item-category;
    private property <string> failed-ingredient-name:   ProcessContext.error-item-name;
    private property <string> failed-pod-label:         ProcessContext.error-item-details;
    private property <bool> details-expanded: false;
    private property <length> ring-size: 168px;
    private property <length> icon-size: 112px;
    callback cancel();

    // ── Continuous slow breathing pulse on the broken ring ───────
    property <bool> pulse: false;
    Timer {
        interval: Motion.breathe;
        running: true;
        triggered => { root.pulse = !root.pulse; }
    }

    HorizontalLayout {

        // ════════════════════════════════════════════════════
        //  LEFT  —  status icon
        // ════════════════════════════════════════════════════
        Rectangle {
            width: Layout.side-panel-width;
            horizontal-stretch: 0;
            background: Palette.surface;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Palette.border;
            }

            CornerDeco {
                width: parent.width;
                height: parent.height;
            }

            VerticalLayout {
                alignment: center;
                spacing: 0;

                // ── Broken-ring icon ─────────────────────────
                HorizontalLayout {
                    alignment: center;
                    icon-stack := Rectangle {
                        width: root.ring-size;
                        height: root.ring-size;
                        background: transparent;

                        // Static amber base ring (the "glass rim")
                        Rectangle {
                            width: root.icon-size;
                            height: root.icon-size;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.height / 2;
                            border-width: root.pulse ? 1px : Layout.accent-bar;
                            border-color: root.pulse ? Palette.border : Palette.text-error;
                            background: Palette.surface-elevated;
                            animate border-color, border-width {
                                duration: Motion.reveal;
                                easing: ease-in-out;
                            }
                        }

                        Path {
                            width: root.icon-size;
                            height: root.icon-size;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            // triangle, gently rounded corners
                            commands: "M 50 32 Q 52 32 53 34 L 64 58 Q 66 62 62 62 L 38 62 Q 34 62 36 58 L 47 34 Q 48 32 50 32 Z";
                            fill: transparent;
                            stroke: root.pulse ? Palette.border : Palette.text-error;
                            stroke-width: Layout.border-width-strong;
                            opacity: root.mounted ? 1 : 0;
                            animate opacity, stroke {
                                duration: Motion.reveal;
                                easing: ease-in-out;
                            }
                        }

                        Path {
                            width: root.icon-size;
                            height: root.icon-size;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            // exclamation bar + dot
                            commands: "M 49 41 L 51 41 L 50.5 51 L 49.5 51 Z M 48.5 55 L 51.5 55 L 51.5 58 L 48.5 58 Z";
                            fill: root.pulse ? Palette.border : Palette.text-error;
                            stroke: transparent;
                            opacity: root.mounted ? 1 : 0;
                            animate opacity, fill {
                                duration: Motion.reveal;
                                easing: ease-in-out;
                            }
                        }
                    }
                }

                Rectangle {
                    height: Layout.spacing-lg;
                    background: transparent;
                }

                VerticalLayout {
                    spacing: Layout.spacing-sm;
                    opacity: root.mounted ? 1 : 0;
                    animate opacity {
                        duration: Motion.reveal;
                        delay: 280ms;
                    }

                    CaptionText {
                        tone: TextTone.error;
                        text: "ZUBEREITUNG UNTERBROCHEN";
                        horizontal-alignment: center;
                    }

                    BodyText {
                        tone: TextTone.interactive;
                        text: root.cocktail-name;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════
        //  RIGHT  —  details & actions
        // ════════════════════════════════════════════════════
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.surface;

            VerticalLayout {
                padding: Layout.spacing-xl * 1.4;
                spacing: 0;
                alignment: center;

                DisplayText {
                    tone: TextTone.interactive;
                    horizontal-alignment: center;
                    text: root.customer-title;
                    opacity: root.mounted ? 1 : 0;
                    animate opacity {
                        duration: Motion.reveal;
                        delay: 320ms;
                    }
                }

                Rectangle {
                    height: Layout.spacing-sm;
                    background: transparent;
                }

                BodyText {
                    text: root.customer-message;
                    wrap: word-wrap;

                    opacity: root.mounted ? 1 : 0;
                    animate opacity {
                        duration: Motion.reveal;
                        delay: 360ms;
                    }
                }

                Rectangle {
                    height: Layout.spacing-lg;
                    background: transparent;
                }

                // ── Technische Details (dezent, für das Personal) ────
                details-toggle-area := TouchArea {
                    height: Layout.touch-height-sm;
                    opacity: root.mounted ? 1 : 0;
                    animate opacity {
                        duration: Motion.reveal;
                        delay: 420ms;
                    }
                    clicked => { root.details-expanded = !root.details-expanded; }

                    HorizontalLayout {
                        alignment: start;
                        CaptionText {
                            tone: root.details-expanded ? TextTone.interactive : TextTone.muted;
                            horizontal-alignment: center;
                            text: (root.details-expanded ? "▾ " : "▸ ") + "Technische Details";
                        }
                    }
                }

                if root.details-expanded: VerticalLayout {
                    spacing: Layout.spacing-sm;
                    padding-top: Layout.spacing-sm;

                    CaptionText {
                        horizontal-alignment: center;
                        text: root.technical-title;
                    }

                    BodyText {
                        tone: TextTone.interactive;
                        text: root.technical-reason;
                        wrap: word-wrap;
                    }

                    // ── Failed-at-step detail ─────────────────────
                    if root.failed-ingredient-name != "": VerticalLayout {
                        spacing: Layout.spacing-sm;
                        padding-top: Layout.spacing-xs;

                        CaptionText {
                            horizontal-alignment: center;
                            text: "UNTERBROCHEN BEI";
                        }

                        ErrorDetailRow {
                            icon: root.failed-ingredient-icon;
                            label: root.failed-ingredient-name;
                            sub-label: root.failed-pod-label;
                        }
                    }
                }

                Rectangle {
                    height: Layout.spacing-xl;
                    background: transparent;
                }

                // ── Actions ────────────────────────────────────
                Button {
                    text: "ABBRECHEN";
                    opacity: root.mounted ? 1 : 0;
                    animate opacity {
                        duration: Motion.reveal;
                        delay: 520ms;
                    }
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
