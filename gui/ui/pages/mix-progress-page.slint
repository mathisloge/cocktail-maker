import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Button } from "../components/button.slint";
import { Chip } from "../components/chip.slint";
import { LoadingSpinner } from "../components/loading-spinner.slint";
import { ProgressBar } from "../components/progress-bar.slint";
import { SeparatorText } from "../components/separator-text.slint";
import { DisplayText, CaptionText } from "../components/text.slint";
import { Page } from "../types/navigation.slint";
import { RecipeView, CommandStatus } from "../types/recipe.slint";
import { ProcessContext } from "../globals/process-context.slint";
import { RecipeContext } from "../globals/recipe-context.slint";
import { StationStateContext } from "../globals/station-state-context.slint";
import { CommandItem } from "../widgets/command-item.slint";
import { GlassCard } from "../widgets/glass-card.slint";
import { PageBase } from "./page-base.slint";

export component MixProgressPage inherits PageBase {
    private property <RecipeView> recipe: RecipeContext.active-recipe;
    GridLayout {
        VerticalLayout {
            width: 33%;
            alignment: space-between;
            cross-axis-alignment: center;
            padding: Layout.spacing-lg;
            padding-top: Layout.spacing-xl;
            rowspan: 1;

            VerticalLayout {
                alignment: start;
                cross-axis-alignment: center;
                spacing: Layout.spacing-sm;
                CaptionText {
                    tone: TextTone.interactive;
                    horizontal-alignment: center;
                    text: "WIRD ZUBEREITET";
                }

                DisplayText {
                    horizontal-alignment: center;
                    text: recipe.name;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: Layout.spacing-sm;
                ProgressBar {
                    indeterminate: true;
                    height: 2px;
                    width: 90%;
                }

                CaptionText {
                    horizontal-alignment: center;
                    text: "rezept wird zubereitet...";
                }
            }

            GlassCard {
                descriptor: ProcessContext.glass;
            }

            Chip {
                text: ProcessContext.glass-volume + " mL";
            }
        }

        Rectangle {
            width: 1px;
            height: 100%;
            background: Palette.border;
        }

        VerticalLayout {
            padding: Layout.spacing-xl;
            spacing: Layout.spacing-md;
            alignment: LayoutAlignment.start;
            rowspan: 2;

            SeparatorText {
                text: "SCHRITTE:";
            }

            VerticalLayout {
                spacing: Layout.spacing-sm;

                for command in recipe.commands: CommandItem {
                    command: command;
                }
            }

            Button {
                text: "ABBRECHEN";
                secondary: true;
                clicked => { ProcessContext.abort(); }
            }
        }
    }
}
