import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { Typography } from "../theme/typography.slint";
import { Button } from "../components/button.slint";
import { CornerDeco } from "../components/corner-deco.slint";
import { LabelText, HeadlineText, CaptionText } from "../components/text.slint";
import { ProcessContext } from "../globals/process-context.slint";
import { RecipeContext } from "../globals/recipe-context.slint";
import { BoostText } from "../widgets/boost-text.slint";
import { PageBase } from "./page-base.slint";

component StatChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <TextTone> value-tone: TextTone.primary;

    background: Palette.surface-card;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding-top: Layout.spacing-sm;
        padding-bottom: Layout.spacing-sm;
        padding-left: Layout.spacing-md;
        padding-right: Layout.spacing-md;
        spacing: Layout.spacing-xs;
        alignment: center;

        CaptionText {
            text: root.label;
            horizontal-alignment: center;
        }

        LabelText {
            text: root.value;
            font-italic: false;
            emphasized: true;
            tone: root.value-tone;
            horizontal-alignment: center;
        }
    }
}


export component MixSuccessPage inherits PageBase {
    private property <string> cocktail-name: RecipeContext.active-recipe.name;
    private property <duration> prep-time-seconds: ProcessContext.elapsed-time;
    private property <int> boost-value: ProcessContext.boost;
    callback finish();

    Timer {
        interval: 5s;
        running: true;
        triggered => { finish(); }
    }

    VerticalLayout {
        padding-top: Layout.spacing-xl * 1.4;
        padding-bottom: Layout.spacing-xl * 1.4;
        padding-left: Layout.spacing-xl * 1.2;
        padding-right: Layout.spacing-xl * 1.2;
        spacing: 0;
        alignment: center;

        HeadlineText {
            tone: TextTone.interactive;
            horizontal-alignment: center;
            text: root.cocktail-name;
            font-italic: true;
            opacity: root.mounted ? 1 : 0;
            animate opacity {
                duration: Motion.mount-duration;
                easing: Motion.mount-easing;
                delay: 320ms;
            }
        }

        Rectangle {
            height: Layout.spacing-sm;
            background: transparent;
        }

        BoostText {
            boost: root.boost-value;
            horizontal-alignment: center;
            opacity: root.mounted ? 1 : 0;
            animate opacity {
                duration: Motion.mount-duration;
                easing: Motion.mount-easing;
                delay: 360ms;
            }
        }

        Rectangle {
            height: Layout.spacing-lg;
            background: transparent;
        }

        VerticalLayout {
            spacing: Layout.spacing-sm;
            opacity: root.mounted ? 1 : 0;
            animate opacity {
                duration: Motion.mount-duration;
                easing: Motion.mount-easing;
                delay: 420ms;
            }

            CaptionText {
                horizontal-alignment: center;
                text: "ZUSAMMENFASSUNG";
            }

            HorizontalLayout {
                spacing: Layout.spacing-sm;

                StatChip {
                    label: "BOOST";
                    value: root.boost-value == 0
                        ? "Normal"
                        : (root.boost-value > 0 ? "+" : "") + Math.round(root.boost-value) + "%";
                    value-tone: root.boost-value > 0 ? TextTone.boost-positive
                        : root.boost-value < 0 ? TextTone.boost-negative
                        : TextTone.highlight;
                }

                StatChip {
                    label: "ZEIT";
                    value: root.prep-time-seconds / 1s + "s";
                    value-tone: TextTone.success;
                }
            }
        }

        Rectangle {
            height: Layout.spacing-md;
            background: transparent;
        }

        VerticalLayout {
            spacing: Layout.spacing-sm;
            opacity: root.mounted ? 1 : 0;
            animate opacity {
                duration: Motion.mount-duration;
                easing: Motion.mount-easing;
                delay: 460ms;
            }

            Rectangle {
                height: 2px;
                background: Palette.border;
                border-radius: 1px;
                Rectangle {
                    height: 2px;
                    border-radius: 1px;
                    width: root.mounted ? parent.width : 0px;
                    background: Palette.text-success;
                    animate width {
                        duration: 700ms;
                        easing: ease-out;
                        delay: 200ms;
                    }
                }
            }

            CaptionText {
                horizontal-alignment: center;
                text: "ALLES ERFOLGREICH GEMIXT";
            }
        }

        Rectangle {
            height: Layout.spacing-xl;
            background: transparent;
        }

        Button {
            opacity: root.mounted ? 1 : 0;
            animate opacity {
                duration: Motion.mount-duration;
                easing: Motion.mount-easing;
                delay: 560ms;
            }
            secondary: true;
            text: "FERTIG →";
            clicked => { root.finish(); }
        }
    }
}
