import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { Button } from "../components/button.slint";
import { ScrollArea } from "../components/scroll-area.slint";
import { SeparatorText } from "../components/separator-text.slint";
import { DisplayText, CaptionText, BodyText } from "../components/text.slint";
import { RecipeView } from "../types/recipe.slint";
import { ProcessContext } from "../globals/process-context.slint";
import { RecipeContext } from "../globals/recipe-context.slint";
import { BoostSlider } from "../widgets/boost-slider.slint";
import { BoostText } from "../widgets/boost-text.slint";
import { CommandListItem } from "../widgets/command-list-item.slint";
import { RecipeTags } from "../widgets/recipe-tags.slint";
import { PageBase } from "./page-base.slint";

export component RecipeDetailPage inherits PageBase {
    private property <RecipeView> recipe: RecipeContext.active-recipe;
    private property <int> boost-value: 0;
    callback process-recipe();

    sidebar := VerticalLayout {
        x: 0;
        y: 0;
        width: 33%;
        padding: Layout.spacing-lg;
        padding-bottom: Layout.spacing-xl * 1.5;
        spacing: Layout.spacing-xl * 1.5;
        cross-axis-alignment: center;
        alignment: end;
        opacity: root.mounted ? 1 : 0;
        animate opacity {
            duration: Motion.mount-duration;
            easing: Motion.mount-easing;
        }
        Image {
            source: recipe.image;
        }

        Rectangle {
            width: 90%;
            background: Palette.border;
            height: 1px;
        }

        VerticalLayout {
            spacing: Layout.spacing-sm;
            cross-axis-alignment: center;
            alignment: center;
            DisplayText {
                horizontal-alignment: center;
                text: recipe.name;
                wrap: word-wrap;
            }

            RecipeTags {
                tags: recipe.tag-line;
            }
        }
    }

    split := Rectangle {
        width: 1px;
        height: 100%;
        x: sidebar.width;
        y: 0;
        background: Palette.border;
    }

    content := VerticalLayout {
        x: split.x + split.width;
        y: 0;
        width: root.width - sidebar.width - split.width;
        padding: Layout.spacing-lg;
        padding-top: Layout.spacing-xl;
        padding-bottom: Layout.spacing-xl * 1.5;
        spacing: Layout.spacing-md;
        alignment: LayoutAlignment.space-between;
        opacity: root.mounted ? 1 : 0;
        animate opacity {
            duration: Motion.mount-duration;
            easing: Motion.mount-easing;
        }

        VerticalLayout {
            spacing: content.spacing;
            BodyText {
                tone: TextTone.muted;
                text: recipe.description;
                wrap: word-wrap;
            }

            Rectangle { }

            SeparatorText {
                text: "ZUTATEN:";
            }

            GridLayout {
                spacing: Layout.spacing-sm;
                for command[index] in recipe.commands: CommandListItem {
                    row: index / 2;
                    col: Math.mod(index, 2);
                    command: command;
                }
            }

            if recipe.is-boostable: SeparatorText {
                text: "ALKOHOL BOOST:";
            }

            if recipe.is-boostable: BodyText {
                text: "💪 Alkoholgehalt boosten (" + boost-value + "%)";
            }

            if recipe.is-boostable: HorizontalLayout {
                padding: Layout.spacing-sm;
                spacing: Layout.spacing-sm;
                cross-axis-alignment: center;
                CaptionText {
                    tone: TextTone.boost-negative;
                    horizontal-alignment: center;
                    text: "milde";
                }

                booster := BoostSlider {
                    value: root.boost-value;

                    changed(value) => {
                        boost-value = value;
                        RecipeContext.boost-active-recipe(value)
                    }
                }

                CaptionText {
                    tone: TextTone.boost-positive;
                    horizontal-alignment: center;
                    text: "stark";
                }
            }
        }

        if recipe.is-boostable: BoostText {
            boost: root.boost-value;
            horizontal-alignment: center;
        }

        Button {
            text: "Zubereiten →";
            clicked => {
                ProcessContext.boost = root.boost-value;
                root.process-recipe();
            }
        }
    }
}
