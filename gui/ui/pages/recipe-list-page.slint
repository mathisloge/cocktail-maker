import { ScrollView } from "std-widgets.slint";
import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { RecipeContext } from "../globals/recipe-context.slint";
import { RecipeCard } from "../widgets/recipe-card.slint";
import { PageBase } from "./page-base.slint";

export component RecipeListPage inherits PageBase {
    callback recipe-selected();

    ScrollView {
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;

        GridLayout {
            padding: Layout.spacing-sm;
            spacing: Layout.spacing-xs;
            for recipe[index] in RecipeContext.recipes: RecipeCard {
                row: index / 3;
                col: Math.mod(index, 3);
                width: (root.width - 2 * parent.padding - 2 * parent.spacing) / 3;
                height: self.width;
                recipe: recipe;
                opacity: root.mounted ? 1 : 0;
                animate opacity {
                    delay: index * 50ms;
                    duration: Motion.mount-duration;
                    easing: Motion.mount-easing;
                }
                clicked => {
                    RecipeContext.active-recipe = recipe;
                    root.recipe-selected()
                }
            }
        }
    }
}
