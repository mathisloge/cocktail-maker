// Raw color values. Only Palette uses them, everything else reads the semantic tokens of Palette.
global Primitives {
    out property <color> ink: #0a0806;
    out property <color> ink-raised: #120e0a;
    out property <color> ink-elevated: #1c1510;
    out property <color> amber: #c8913a;
    out property <color> amber-light: #e8b86d;
    out property <color> cream: #f5eed8;
    out property <color> sand: #d9cfae;
    out property <color> red: #c0392b;
    out property <color> green: #5cad75;
    out property <color> black: #000000;

    // The boost slider stays out of the amber/black/cream family on purpose.
    out property <color> slate: #3d6f85;
    out property <color> slate-light: #86aebd;
    out property <color> ember: #a8562f;
    out property <color> ember-light: #d99569;

    out property <color> log-gray-blue: #7A8594;
    out property <color> log-blue: #3B6EA8;
    out property <color> log-green: #4A8F5A;
    out property <color> log-amber: #C58A2B;
    out property <color> log-orange-red: #C55A3D;
    out property <color> log-dark-red: #A12D2D;
}

export enum TextTone {
    primary,
    interactive,
    highlight,
    label,
    muted,
    on-accent,
    error,
    success,
    boost-negative,
    boost-positive,
    log-trace,
    log-debug,
    log-info,
    log-warn,
    log-error,
    log-critical,
}

export global Palette {
    // Surfaces
    out property <color> surface: Primitives.ink;
    out property <color> surface-card: Primitives.ink-raised;
    out property <color> surface-elevated: Primitives.ink-elevated;

    // Borders
    out property <color> border: Primitives.amber.with-alpha(0.24);
    out property <color> border-strong: Primitives.amber;
    out property <color> border-subtle: Primitives.amber.with-alpha(0.08);

    // Accent
    out property <color> accent: Primitives.amber;
    out property <color> accent-light: Primitives.amber-light;
    out property <color> accent-dim: Primitives.amber.with-alpha(0.14);

    // Text
    out property <color> text-primary: Primitives.cream;
    // Amber, reserved for interactive or selected text.
    out property <color> text-interactive: Primitives.amber;
    // Muted warm neutral for static section labels.
    out property <color> text-label: Primitives.sand;
    // Stays legible under glare.
    out property <color> text-muted: Primitives.cream.with-alpha(0.68);
    out property <color> text-on-accent: Primitives.ink;
    out property <color> text-error: Primitives.red;
    out property <color> text-success: Primitives.green;

    // Boost slider
    out property <color> boost-negative: Primitives.slate;
    out property <color> boost-positive: Primitives.ember;
    out property <color> boost-negative-text: Primitives.slate-light;
    out property <color> boost-positive-text: Primitives.ember-light;

    // Elevation
    out property <color> shadow: Primitives.black.with-alpha(0.4);

    // Processing states
    out property <color> status-waiting: Primitives.cream.with-alpha(0.52);
    out property <color> status-pouring: Primitives.amber;
    out property <color> status-done: Primitives.cream.with-alpha(0.33);

    // Overlays
    out property <color> overlay-done: Primitives.ink.with-alpha(0.92);
    out property <color> overlay-card-scrim: Primitives.ink.with-alpha(0.62);
    out property <color> overlay-scrim: Primitives.ink.with-alpha(0.88);

    // Log levels
    out property <color> log-trace: Primitives.log-gray-blue;
    out property <color> log-debug: Primitives.log-blue;
    out property <color> log-info: Primitives.log-green;
    out property <color> log-warn: Primitives.log-amber;
    out property <color> log-error: Primitives.log-orange-red;
    out property <color> log-critical: Primitives.log-dark-red;

    pure public function text-color(tone: TextTone) -> color {
        if (tone == TextTone.interactive) {
            return root.text-interactive;
        }
        if (tone == TextTone.highlight) {
            return root.accent-light;
        }
        if (tone == TextTone.label) {
            return root.text-label;
        }
        if (tone == TextTone.muted) {
            return root.text-muted;
        }
        if (tone == TextTone.on-accent) {
            return root.text-on-accent;
        }
        if (tone == TextTone.error) {
            return root.text-error;
        }
        if (tone == TextTone.success) {
            return root.text-success;
        }
        if (tone == TextTone.boost-negative) {
            return root.boost-negative-text;
        }
        if (tone == TextTone.boost-positive) {
            return root.boost-positive-text;
        }
        if (tone == TextTone.log-trace) {
            return root.log-trace;
        }
        if (tone == TextTone.log-debug) {
            return root.log-debug;
        }
        if (tone == TextTone.log-info) {
            return root.log-info;
        }
        if (tone == TextTone.log-warn) {
            return root.log-warn;
        }
        if (tone == TextTone.log-error) {
            return root.log-error;
        }
        if (tone == TextTone.log-critical) {
            return root.log-critical;
        }
        return root.text-primary;
    }
}
