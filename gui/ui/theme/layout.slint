export global Layout {
    out property <length> touch-height: 75px;
    out property <length> touch-height-sm: 48px;

    // ── Spacing scale ───────────────────────────────────
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 40px;

    // ── Radius scale ────────────────────────────────────
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 16px;

    // Lines and borders
    out property <length> border-width-strong: 2px;
    out property <length> accent-bar: 3px;
    out property <length> progress-height: 2px;

    // Shadows
    out property <length> shadow-card-blur: 10px;
    out property <length> shadow-card-offset: 3px;
    out property <length> shadow-popup-blur: 24px;

    // Fixed sizes
    out property <length> window-width: 1280px;
    out property <length> window-height: 720px;
    out property <length> back-button-width: 120px;
    out property <length> side-panel-width: 380px;
    out property <length> list-row-height: 50px;
    out property <length> glass-card-width: 168px;
    out property <length> glass-card-height: 232px;
    out property <length> glass-icon-size: 84px;
    out property <length> volume-chip-width: 110px;
}
