export global Motion {
    // Pages fade in once after mounting.
    out property <duration> mount-delay: 60ms;
    out property <duration> mount-duration: 200ms;
    out property <easing> mount-easing: ease-in;

    out property <duration> quick: 150ms;
    out property <duration> normal: 200ms;
    out property <duration> reveal: 400ms;
    // Delay between the entries of a list that fades in.
    out property <duration> stagger: 50ms;
    out property <duration> pulse: 700ms;
    out property <duration> breathe: 1700ms;
    out property <duration> long-press: 4s;
}
