export enum DispenserType {
    pump,
    valve,
}

export struct Dispenser {
    id: int,
    type: DispenserType,
    label: string,
    ingredient-name: string,
    fill-text: string,
    fill-known: bool,
    fill-ratio: float,
    almost-empty: bool,
}

export enum ConnectionState {
    disconnected,
    connecting,
    connected,
    incompatible,
}

export struct Pod {
    id: string,
    connection_state: ConnectionState,
    status-text: string,
    firmware-version: string,
    pump-count: int,
    valve-count: int,
    dispensers: [Dispenser],
    // How many dispensers the Pods before this one have, so that the admin tiles of all Pods flow in one grid.
    tile-offset: int,
}
