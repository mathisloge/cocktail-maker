import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Typography } from "../theme/typography.slint";
import { LoadingSpinner } from "../components/loading-spinner.slint";
import { BodyText } from "../components/text.slint";
import { Command, CommandStatus } from "../types/recipe.slint";

export component CommandItem inherits Rectangle {
    in property <Command> command;
    background: Palette.surface-card;
    animate background { duration: 200ms; }
    border-color: Palette.border;
    border-width: 1px;

    HorizontalLayout {
        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: center;
        padding: Layout.spacing-sm;
        BodyText {
            text: command.text + " - " + command.value;
        }

        if command.status == CommandStatus.not-started: BodyText {
            tone: TextTone.interactive;
            text: "not started";
        }

        if command.status == CommandStatus.in-progress: LoadingSpinner {
            height: Typography.label-size;
            indeterminate: true;
        }

        if command.status == CommandStatus.finished: BodyText {
            tone: TextTone.interactive;
            text: "✓";
        }
    }

    states [
        not-started when command.status == CommandStatus.not-started: {}
        in-progress when command.status == CommandStatus.in-progress: {
            root.background: Palette.surface-elevated;
        }
        finished when command.status == CommandStatus.finished: {}
    ]
}
