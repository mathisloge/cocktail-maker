import { Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { MediumText } from "../components/medium-text.slint";
import { Command } from "../types/recipe.slint";

export component CommandListItem {
    in property <Command> command;
    VerticalLayout {
        spacing: Layout.spacing-sm;
        HorizontalLayout {
            alignment: LayoutAlignment.space-between;
            MediumText {
                text: command.text;
                primary: true;
            }

            MediumText {
                text: command.value;
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border-subtle;
        }
    }
}
