import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { BodyText } from "../components/text.slint";
import { GlassDescriptor } from "../types/glass.slint";
import { GlassIcon } from "./glass-icon.slint";

export component GlassCard inherits Rectangle {
    in property <GlassDescriptor> descriptor;
    in property <bool> selected;
    callback clicked();

    width: Layout.glass-card-width;
    height: Layout.glass-card-height;
    border-radius: Layout.radius-md;
    background: root.selected ? Palette.accent-dim : (ta.pressed ? Palette.surface-elevated : Palette.surface-card);
    border-width: root.selected ? Layout.border-width-strong : 1px;
    border-color: root.selected ? Palette.border-strong : (ta.pressed ? Palette.border-strong : Palette.border);

    drop-shadow-color: Palette.shadow;
    drop-shadow-blur: Layout.shadow-card-blur;
    drop-shadow-offset-y: Layout.shadow-card-offset;

    animate background, border-color, border-width { duration: Motion.mount-duration / 3; }

    VerticalLayout {
        padding: Layout.spacing-md;
        spacing: Layout.spacing-sm;
        alignment: center;
        cross-axis-alignment: center;

        GlassIcon {
            data: root.descriptor.icon;
            stroke-color: root.selected ? Palette.accent : Palette.text-muted;
            stroke-width: root.selected ? Layout.accent-bar : Layout.border-width-strong;
            width: Layout.glass-icon-size;
            height: Layout.glass-icon-size * root.descriptor.icon.viewbox-height / max(1, root.descriptor.icon.viewbox-width);
            horizontal-stretch: 0;
        }

        BodyText {
            text: root.descriptor.display-name;
            emphasized: root.selected;
            tone: root.selected ? TextTone.primary : TextTone.interactive;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}
