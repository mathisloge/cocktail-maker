import { TextTone, Palette } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { Motion } from "../theme/motion.slint";
import { Typography } from "../theme/typography.slint";
import { TitleText } from "../components/text.slint";
import { RecipeView } from "../types/recipe.slint";
import { RecipeTags } from "./recipe-tags.slint";

export component RecipeCard inherits Rectangle {
    in property <RecipeView> recipe: {
        name: "ExampleName",
        tag_line: ["CLASSIC", "ANTIALKOHOLISCH", "TESTTESTETST"],
        description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla nisi elit, bibendum vitae mi nec, sodales vulputate felis. Etiam maximus ligula non neque porttitor tincidunt."
    };
    callback clicked();
    border-color: Palette.border;
    border-width: Layout.border-width-strong;
    background: Palette.surface-card;
    animate background, border-color { duration: Motion.normal; }

    drop-shadow-color: Palette.shadow;
    drop-shadow-blur: Layout.shadow-card-blur;
    drop-shadow-offset-y: Layout.shadow-card-offset;

    preferred-width: 250px;
    height: self.width;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: recipe.image;
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {

        Rectangle {
            vertical-stretch: 3;
        }

        Rectangle {
            border-color: Palette.border;
            border-width: Layout.border-width-strong;
            background: Palette.surface-elevated;

            VerticalLayout {
                padding: Layout.spacing-lg;
                TitleText {
                    text: recipe.name;
                }

                RecipeTags {
                    tags: recipe.tag-line;
                }
            }
        }
    }

    states [
        inactive when !ta.has-hover && !ta.pressed: {}
        active-hover when ta.has-hover: {
            root.background: @radial-gradient(circle, Palette.accent 0%, Palette.surface-card 90%);
        }
        pressed when ta.pressed: {
            root.background: @radial-gradient(circle, Palette.accent 0%, Palette.surface-card 90%);
            root.border-color: Palette.border-strong;
        }
    ]
}
