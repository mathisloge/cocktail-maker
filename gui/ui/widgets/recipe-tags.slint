import { TextTone } from "../theme/colors.slint";
import { Layout } from "../theme/layout.slint";
import { CaptionText } from "../components/text.slint";

export component RecipeTags inherits HorizontalLayout {
    in property <[string]> tags;
    padding-top: Layout.spacing-sm;
    alignment: LayoutAlignment.start;
    for t[i] in tags: CaptionText {
        tone: TextTone.interactive;
        text: t + ((i < (tags.length - 1)) ? " | " : "");
        horizontal-alignment: left;
        overflow: ((i < (tags.length - 1)) ? TextOverflow.clip : elide);
    }
}
